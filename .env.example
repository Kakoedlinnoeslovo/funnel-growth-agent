GROWTH_LOOP_DIR=../growth-loop
PRICING_LAB_DIR=../recraft-pricing-lab
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Gemini describes creatives, reads reference-landing screenshots, and generates showcase
# tiles (default: Nano Banana 2 = gemini-3.1-flash-image; optional Pro = gemini-3-pro-image).
# GEMINI_MODEL selects analysis/judging, not the image-generation model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional. A glam.ai key (glm_*) routes showcase tiles through glam instead of Gemini
# (text prompts only; no reference images).
# GLAM_API_KEY=
# Candidates generated per showcase tile before the Gemini judge picks one (1-4).
TILE_VARIANTS=3
# Optional. A separate data dir (memory, caches, recordings) so a demo never mixes with
# real runs. The README's demo section uses ./data-demo.
# FUNNEL_GROWTH_DATA_DIR=
# Optional. Path to the gstack `browse` binary used by research_landing. Defaults to
# ~/.claude/skills/gstack/browse/dist/browse, then ~/.agents/skills/gstack/browse/dist/browse.
# GSTACK_BROWSE=
# Optional competitor discovery. This needs Meta Ads Library access; an owned-account
# META_ADS_TOKEN is not used here. Without Library access, research tries public browse
# and supplied Ads Library links. Blocked sources stay unavailable, never invented.
# META_AD_LIBRARY_TOKEN=
# META_AD_LIBRARY_API_VERSION=v23.0
# The demo defaults to GB and Kittl, Canva, Zeely, Runway, Luma AI; change these in its
# research controls. Successful observations expire after 24h; Refresh bypasses the cache.
# Public landings supplied directly are marked as references, not verified ad destinations.
# Optional. Defaults to `default_version` in <PRICING_LAB_DIR>/funnels/site.yaml.
# BASE_VERSION=v7
MAX_REPORT_AGE_HOURS=48
MIN_LANDING_PEOPLE=100
MIN_CREATIVE_SPEND=5
MIN_CREATIVE_CLICKS=10

# Existing GitHub → Vercel auto-deployment (public version paths; default landing preserved).
# Prepare publishing preview refreshes from this branch; Publish pushes only the new version.
# GITHUB_PUBLISH_REPO=recraft-ai/recraft-pricing-performance
# GITHUB_PUBLISH_BRANCH=main
# GITHUB_PUBLIC_ORIGIN=https://recraft-pricing-performance.vercel.app
# Optional public frontend overrides matching Vercel's production environment.
# GITHUB_PUBLISH_VITE_RECRAFT_API_URL=https://api.recraft.ai

# Alternative: a separate public Vercel preview deployment (never --prod or a live alias).
# Install/sign in to the Vercel CLI. Either `vercel link` in the pricing lab, or set both IDs.
# The destination project must allow public preview deployments.
# VERCEL_BIN=vercel
# VERCEL_PROJECT_ID=
# VERCEL_ORG_ID=
