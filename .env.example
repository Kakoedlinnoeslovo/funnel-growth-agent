GROWTH_LOOP_DIR=../growth-loop
PRICING_LAB_DIR=../recraft-pricing-performance
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Gemini describes creatives, reads reference-landing screenshots, and generates showcase
# tiles (Nano Banana 2 = gemini-3.1-flash-image, Nano Banana Pro = gemini-3-pro-image).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional. A glam.ai key (glm_*) routes showcase tiles through glam instead of Gemini
# (text prompts only; no reference images).
# GLAM_API_KEY=
# Candidates generated per showcase tile before the Gemini judge picks one (1-4).
TILE_VARIANTS=3
# Optional. A separate data dir (memory, caches, recordings) so a demo never mixes with
# real runs. The README's demo section uses ./data-demo.
# FUNNEL_GROWTH_DATA_DIR=
# Optional. Path to the gstack `browse` binary used by research_landing. Defaults to
# ~/.claude/skills/gstack/browse/dist/browse.
# GSTACK_BROWSE=
# Optional. Defaults to `default_version` in <PRICING_LAB_DIR>/funnels/site.yaml.
# BASE_VERSION=v7
MAX_REPORT_AGE_HOURS=48
MIN_LANDING_PEOPLE=100
MIN_CREATIVE_SPEND=5
MIN_CREATIVE_CLICKS=10
